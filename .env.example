# Synapse Environment Configuration
# Copy this file to .env to configure your local or production instance.

# Host Port Mapping (default: 3000)
HOST_PORT=3000

# Database Storage Directory inside container
SYNAPSE_DATA_DIR=/app/data

# Backup Directory inside container
SYNAPSE_BACKUP_DIR=/app/backups

# Optional: Pre-shared API Key for Headless AI Agents, MCP Server, and Scripts
# When set, requests passing 'Authorization: Bearer <SYNAPSE_API_KEY>' or 'x-api-key'
# bypass Cloudflare Access / proxy authentication.
SYNAPSE_API_KEY=

# Optional: Obsidian Vault Mount Path inside container (default: empty / disabled)
# When set and mounted, allows 1-click note and asset export to your Obsidian vault.
OBSIDIAN_VAULT_PATH=

# Authentication Mode: 'none' | 'cloudflare' | 'header'
# - 'none': Open access (recommended for private LAN, VPN, or local machine)
# - 'cloudflare': Validates cf-access-authenticated-user-email against ALLOWED_EMAILS
# - 'header': Validates reverse-proxy headers (e.g. Authelia, Authentik, Tailscale)
AUTH_MODE=none

# Cloudflare Zero Trust Authorization (Comma-separated list of allowed user emails)
# Required when AUTH_MODE=cloudflare
ALLOWED_EMAILS=user@example.com

# Google Drive & Google Docs Export Integration (optional)
GOOGLE_OAUTH_ACCESS_TOKEN=
GOOGLE_SERVICE_ACCOUNT_KEY=
