{
  "id": "/",
  "name": "Synapse — AI-Native RSS++ Reader",
  "short_name": "Synapse",
  "description": "Private AI-native RSS++ reader, newsletter deep-link curator, and Obsidian knowledge engine",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#090d16",
  "theme_color": "#090d16",
  "categories": ["news", "productivity", "utilities"],
  "icons": [
    {
      "src": "/favicon.ico",
      "sizes": "32x32",
      "type": "image/x-icon"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Unread Articles",
      "short_name": "Unread",
      "description": "View unread news and articles",
      "url": "/?view=unread",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Research Inbox",
      "short_name": "Research",
      "description": "Curated deep-links and reading list",
      "url": "/?view=reading_list",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Manage Feeds",
      "short_name": "Feeds",
      "description": "Feed reachability and health management",
      "url": "/?view=feed_manager",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Stats & Analytics",
      "short_name": "Stats",
      "description": "Reading speed, velocity and statistics",
      "url": "/?view=stats",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
